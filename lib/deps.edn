;; me.tonsky.persistent-sorted-set, the Eve port — a library for Eve.
;; Its B-tree runs on Eve's own types, so it depends on Eve itself.
;; Release pin: the published 0.9.3.1 tree, same sha as ../deps.edn.
;; Dev/test gates launched from the repo root with -A:dev override this
;; via :override-deps (see ../deps.edn). Do not retarget this default
;; pin to an unreleased work branch.
{:paths ["."]
 :deps {org.clojure/clojure {:mvn/version "1.12.0"}
        eve/eve {:git/url "https://github.com/SeniorCareMarket/eve"
                 :git/sha "4a921298168080c2af9f57fcfcdee2db570dec4c"}}}
