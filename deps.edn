;; eve.db.ds — the library (derived from DataScript, tonsky/DataScript, EPL-1.0).
;;
;; This repository root IS the library: src/eve/db/ds/* and
;; src/data_readers.cljc. Home repo: johnmn3/eve.db.ds — ONE codebase
;; spanning both host sets: every Clojure-like Eve supports (directly on
;; Eve) and every Clojure-like cohost supports (through cohost bodies
;; over the Eve backend).
;;
;; eve/eve below is the PUBLIC Eve release line the DS-in-Eve rewrite
;; targets (DS-IN-EVE-PLAN v2 §3): SeniorCareMarket/eve branch
;; release/eve-0.9.3.3, re-pinned 2026-11-19 to the current release tip 323bfe35901f3f892921eecd41fc5e85be4ef8ec (F3/eve-same? measured in; E1 delivered-type question open with the Eve seat).
;; Re-pinned 2026-11-20 ET to Eve main abba331 (commit bookkeeping per block, delivery per value), after 5a037ef (every eve-deftype: one fast type check, one fast field lookup over both forms), 47e6dae (fast paths for every value written) and e21be6b: Eve main
;; (dcba2ee, release/eve-0.9.3.4) plus the won-swap leak fix (a transact's intermediate index versions were
;; never freed) and the JVM byte-array typing (value-array slot writes and eve.codec stopped reflecting:
;; 53% of a build's samples). test/drivers/cliff has the measurements' drivers.
;; This is the pre-fix pin of EVE-FIX-PLAN §0: the deftype/atom laws
;; probe (test/eve/deftype_atom_laws_test.cljc) is red there on
;; E1–E6 by measurement; the Eve seat lands F1–F3 on this line and
;; this pin moves to the fixed sha when they tag it. The vendored
;; src baseline (src/eve/db/ds) does not load against any Eve yet —
;; upstream conn/core/serialize require the storage namespace the
;; rewrite deletes (v2 §3); see src/UPSTREAM-SRC.txt.
;;
;; Dev runs: there is no dev-pin alias. To run against an Eve dev
;; tree instead of the release pin, use the EVE_ROOT environment
;; override (scripts/eve_dev_cp.sh resolves EVE_ROOT when set) or a
;; -Sdeps {:deps {eve/eve {:local/root <eve-tree>}}} override. The
;; sibling libraries (persistent-sorted-set port, extend-clj) are
;; :local/root deps inside this repository.
{:paths ["src"]
 :deps {org.clojure/clojure {:mvn/version "1.12.0"}
        ;; SCI: the interpreter for stored :db/fn values of the :sci
        ;; kind (eve.db.ds.db-fn). A stored db fn is data (source as a
        ;; string); SCI evaluates it at transact time in a sandbox.
        ;; eve.db.ds.db-fn loads sci.core LAZILY (requiring-resolve on
        ;; first use of the :sci kind; a compile-time require only on
        ;; cljs): the :sci kind is opt-in, so hosts that cannot load
        ;; sci.core (jank) still load the whole library.
        org.babashka/sci {:mvn/version "0.15.59"}
        eve/eve {:git/url "https://github.com/SeniorCareMarket/eve"
                 :git/sha "665bcf84cc72105f257a831e9366e8dc4eebc153"}
        me.tonsky/persistent-sorted-set {:local/root "lib"}
        extend-clj/extend-clj {:local/root "lib-ds-deps"}}
 :aliases
 {:test {:extra-paths ["test/drivers"]}
  ;; Eve deftype/atom laws probe (EVE-FIX-PLAN §4), test/eve/**:
  ;; clojure -M:laws -e "(require 'eve.deftype-atom-laws-test) ..."
  :laws {:extra-paths ["test"]}
  ;; DataScript's upstream test suite (test/upstream-ds, tag 1.8.1, renamed
  ;; datascript. -> eve.db.ds.) + its JVM test deps:
  ;; clojure -M:ds-suite -m contract.ds-suite
  :ds-suite {:extra-paths ["test/drivers" "test/upstream-ds/test"]
             :extra-deps {com.cognitect/transit-clj {:mvn/version "1.0.333"}
                          cheshire/cheshire {:mvn/version "5.12.0"}
                          metosin/jsonista {:mvn/version "0.3.8"}}}}}
