;; The lib's own proof workspace: the shipped contract drivers plus this
;; repo's harness (contract check, people-1k perf, shootout drivers).
;;
;; Release pin lives in the root deps.edn default eve/eve (4a921298).
;; Dev/test pin is alias :dev (atom.broker :deps/root "eve" @ 7840ffe529).
;; From the library root: clojure -A:dev:test -M -m contract.only-core
;; Offline/local override remains -Sdeps {:deps {eve/eve {:local/root <eve-tree>}}}.
{:paths ["drivers" "../harness" "upstream-ds/test"]
 :deps {eve.db.ds/eve.db.ds {:local/root ".."}
        org.clojure/clojure {:mvn/version "1.12.0"}
        org.clojure/test.check {:mvn/version "1.1.1"}}
 :aliases
 {:dev {:override-deps
        {eve/eve {:git/url "https://github.com/johnmn3/atom.broker"
                  :git/sha "7840ffe52928f82784ff164e92666620f794f34d"
                  :deps/root "eve"}}}}}
