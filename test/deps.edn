;; The lib's own proof workspace: the shipped contract drivers plus this
;; repo's harness (contract check, people-1k perf, shootout drivers).
;;
;; Release pin lives in the root deps.edn default eve/eve
;; (SeniorCareMarket/eve release/eve-0.9.3.2). There is no dev-pin
;; alias: dev runs use the EVE_ROOT environment override
;; (scripts/eve_dev_cp.sh) or a -Sdeps local override,
;; -Sdeps {:deps {eve/eve {:local/root <eve-tree>}}}.
;; From the library root: clojure -A:test -M -m contract.only-core
{:paths ["drivers" "../harness" "upstream-ds/test"]
 :deps {eve.db.ds/eve.db.ds {:local/root ".."}
        org.clojure/clojure {:mvn/version "1.12.0"}
        org.clojure/test.check {:mvn/version "1.1.1"}}}
